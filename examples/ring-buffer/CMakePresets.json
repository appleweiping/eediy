{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-debug",
      "displayName": "Host debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ENABLE_SANITIZERS": "OFF"
      }
    },
    {
      "name": "host-sanitized",
      "displayName": "Host ASan and UBSan",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-sanitized",
      "cacheVariables": {
        "ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug"
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-sanitized",
      "configurePreset": "host-sanitized",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host-debug",
      "steps": [
        {
          "type": "configure",
          "name": "host-debug"
        },
        {
          "type": "build",
          "name": "host-debug"
        },
        {
          "type": "test",
          "name": "host-debug"
        }
      ]
    },
    {
      "name": "host-sanitized",
      "steps": [
        {
          "type": "configure",
          "name": "host-sanitized"
        },
        {
          "type": "build",
          "name": "host-sanitized"
        },
        {
          "type": "test",
          "name": "host-sanitized"
        }
      ]
    }
  ]
}
