{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eediy.dev/schemas/course.schema.json",
  "title": "EEDIY canonical course catalogue",
  "description": "The reviewed, bilingual catalogue generated from research candidates and enriched by maintainers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_at",
    "tracks",
    "courses"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/track"
      }
    },
    "courses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localizedList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "order",
        "title",
        "summary",
        "outcomes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "group": {
          "$ref": "#/$defs/slug"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        },
        "outcomes": {
          "$ref": "#/$defs/localizedList"
        },
        "prerequisite_tracks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          },
          "default": []
        }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "slug",
        "track",
        "title",
        "summary",
        "institution",
        "course_code",
        "role",
        "tier",
        "level",
        "languages",
        "prerequisite_course_ids",
        "prerequisites",
        "official_prerequisites",
        "recommended_background",
        "selection_note",
        "review_note",
        "resource_coverage",
        "resources",
        "last_reviewed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source_id": {
          "type": "integer",
          "minimum": 1
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "track": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "summary": {
          "$ref": "#/$defs/localizedText"
        },
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "course_code": {
          "type": "string"
        },
        "role": {
          "enum": [
            "mainline",
            "alternative",
            "supplement"
          ]
        },
        "tier": {
          "enum": [
            "S",
            "A",
            "B"
          ]
        },
        "level": {
          "enum": [
            "introductory",
            "intermediate",
            "advanced",
            "mixed",
            "unspecified"
          ]
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
          }
        },
        "prerequisite_course_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "default": []
        },
        "prerequisites": {
          "$ref": "#/$defs/localizedList"
        },
        "official_prerequisites": {
          "description": "Provider-published prerequisites, corequisites, permissions, or explicit no-prerequisite statements. Course-sequence entries may link to an exact EEDIY equivalent at render time.",
          "$ref": "#/$defs/localizedList"
        },
        "recommended_background": {
          "description": "EEDIY route advice or practical preparation kept separate from provider requirements.",
          "$ref": "#/$defs/localizedList"
        },
        "selection_note": {
          "$ref": "#/$defs/localizedText"
        },
        "review_note": {
          "$ref": "#/$defs/localizedText"
        },
        "resource_coverage": {
          "$ref": "#/$defs/resourceCoverage"
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "last_reviewed": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "resourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "notes",
        "practice",
        "labs",
        "exams",
        "code"
      ],
      "properties": {
        "video": {
          "$ref": "#/$defs/coverageScore"
        },
        "notes": {
          "$ref": "#/$defs/coverageScore"
        },
        "practice": {
          "$ref": "#/$defs/coverageScore"
        },
        "labs": {
          "$ref": "#/$defs/coverageScore"
        },
        "exams": {
          "$ref": "#/$defs/coverageScore"
        },
        "code": {
          "$ref": "#/$defs/coverageScore"
        }
      }
    },
    "coverageScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2,
      "description": "Internal editorial signal: 0 = no usable set verified in this review; 1 = partial, version-mismatched, or access-restricted set; 2 = a coherent course-level material set usable under the separately recorded access conditions. A score of 2 does not imply every term or file, public solutions, grading, starter code, or feedback."
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "url",
        "access",
        "license",
        "status",
        "last_verified"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "kind": {
          "enum": [
            "course",
            "video",
            "notes",
            "textbook",
            "assignments",
            "labs",
            "projects",
            "exams",
            "code",
            "dataset",
            "simulator",
            "community",
            "other"
          ]
        },
        "title": {
          "$ref": "#/$defs/localizedText"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "access": {
          "enum": [
            "open",
            "open-registration",
            "free-audit",
            "limited-free",
            "paid",
            "institutional"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "available",
            "degraded",
            "archived",
            "unavailable",
            "review-needed"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "artifact_scope": {
          "enum": [
            "content",
            "index",
            "outline",
            "landing",
            "syllabus"
          ],
          "description": "What the URL exposes after access: substantive teaching/assessment content, a link index, a topic/schedule outline, a landing or sales page, or a syllabus. A coverage score of 2 requires matching, available substantive content; a legacy substantive-kind record may omit this field, while non-content records may document only a partial or restricted score of 1."
        },
        "note": {
          "$ref": "#/$defs/localizedText"
        }
      }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
